# Dev env — all services on localhost
NIM_LLM_BASE_URL=http://localhost:8001/v1
NIM_LLM_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
NIM_EMBED_BASE_URL=http://localhost:8002/v1
NIM_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

OPENWEATHERMAP_API_KEY=your_openweather_api_key_here
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgresql://weatherise:weatherise@localhost:5432/weatherise
QDRANT_URL=http://localhost:6333

MCP_SERVER_URL=http://localhost:9000

APP_ENV=development
LOG_LEVEL=info
TIMEZONE=Asia/Ho_Chi_Minh

DEFAULT_LAT=16.0544
DEFAULT_LON=108.2022
DEFAULT_CITY=Da Nang
DEFAULT_COUNTRY=Vietnam

NGC_API_KEY=your_ngc_api_key_here
API_URL=http://localhost:8000
APP_PORT=8000
