# =============================================================
# Weatherise v2 — Environment Variables
# Copy to .env and fill in values
# =============================================================

# --- NVIDIA NIM ---
NGC_API_KEY=your_ngc_api_key_here
NIM_LLM_BASE_URL=http://localhost:8001/v1
NIM_LLM_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
NIM_EMBED_BASE_URL=http://localhost:8002/v1
NIM_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# --- Qwen Parser ---
PARSER_LLM_BASE_URL=http://localhost:8003/v1
PARSER_LLM_MODEL=weatherise-parser-qwen35-27b
PARSER_LLM_TEMPERATURE=0.0
PARSER_LLM_MAX_TOKENS=1024
PARSER_LLM_TIMEOUT_SECONDS=30

# --- Weather APIs ---
OPENWEATHERMAP_API_KEY=your_openweather_api_key_here
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# --- Path B Weather Intelligence ---
WEATHER_EVIDENCE_DIR=/raid/team/weatherise/weather_evidence
WEATHER_EVIDENCE_FALLBACK_DIR=data/weather_evidence
NIM_WEATHER_ARBITER_ENABLED=true
NIM_WEATHER_ARBITER_MODEL=
EARTH2STUDIO_ENABLED=false
EARTH2_OUTPUT_DIR=/raid/team/weatherise/weather_evidence/earth2_processed
WEATHERAPI_KEY=
TOMORROW_IO_API_KEY=
VISUAL_CROSSING_API_KEY=
WEATHERBIT_API_KEY=
METEOSOURCE_API_KEY=
STORMGLASS_API_KEY=
ACCUWEATHER_API_KEY=

# --- Google Places (optional fallback) ---
GOOGLE_PLACES_API_KEY=

# --- Storage ---
REDIS_URL=redis://redis:6379
POSTGRES_URL=postgresql://weatherise:weatherise@postgres:5432/weatherise
QDRANT_URL=http://vector-db:6333

# --- Internal Service URLs (Docker network) ---
MCP_SERVER_URL=http://mcp-server:9000
API_URL=http://api:8000

# --- App Config ---
APP_ENV=production
APP_PORT=8000
LOG_LEVEL=info
TIMEZONE=Asia/Ho_Chi_Minh

# --- Default Location ---
DEFAULT_LAT=16.0544
DEFAULT_LON=108.2022
DEFAULT_CITY=Da Nang
DEFAULT_COUNTRY=Vietnam
